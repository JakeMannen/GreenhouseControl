{
  "name": "ESP-IDF ESP32-C6",
  "image": "espressif/idf:v6.1",
  "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind",
  "workspaceFolder": "/project",
  "mounts": [
    "source=extensionCache,target=/root/.vscode-server/extensions,type=volume",
    "source=/dev,target=/dev,type=bind"
  ],
  "runArgs": [
    "--privileged",
    "--shm-size=1g"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "espressif.esp-idf-extension",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "idf.gitPath": "/usr/bin/git",
        "idf.espIdfPath": "/opt/esp/idf",
        "idf.toolsPath": "/opt/esp",
        "idf.pythonBinPath": "/opt/esp/python_env/idf6.1_py3.12_env/bin/python",
        "idf.port": "/dev/ttyACM0",
        "idf.flashType": "UART",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/src/build/compile_commands.json",
        "C_Cpp.intelliSenseEngine": "default"
      }
    }
  },
  "postCreateCommand": "echo '. /opt/esp/idf/export.sh' >> ~/.bashrc"
}

